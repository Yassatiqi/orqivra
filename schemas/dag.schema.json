{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqivra.dev/schemas/dag.schema.json",
  "title": "ORQIVRA Task DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "objective", "input_snapshot", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "input_snapshot": {"$ref": "#/$defs/hash"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "inputs", "dependencies", "role", "profile", "file_scope", "risk", "acceptance_criteria", "verification", "status", "attempts", "evidence", "blocking_reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "objective": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "role": {"enum": ["orchestrator", "implementer", "complex_implementer", "reviewer"]},
        "profile": {"type": "string", "minLength": 1},
        "file_scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "risk": {"enum": ["low", "medium", "high"]},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["planned", "ready", "running", "verifying", "fix_required", "blocked", "accepted", "obsolete"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 5},
        "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocking_reason": {"type": ["string", "null"]},
        "obligations": {"type": "array", "items": {"$ref": "gate.schema.json#/$defs/gate"}}
      }
    }
  }
}

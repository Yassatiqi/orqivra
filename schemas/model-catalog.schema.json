{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqivra.dev/schemas/model-catalog.schema.json",
  "title": "ORQIVRA Model Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "sources", "defaults", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "claude-code", "gemini-cli"],
      "properties": {
        "codex": {"$ref": "#/$defs/roleModels"},
        "claude-code": {"$ref": "#/$defs/roleModels"},
        "gemini-cli": {"$ref": "#/$defs/roleModels"}
      }
    },
    "models": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/model"}}
  },
  "$defs": {
    "roleModels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestrator", "implementer", "complex_implementer", "reviewer"],
      "properties": {
        "orchestrator": {"type": "string", "minLength": 1},
        "implementer": {"type": "string", "minLength": 1},
        "complex_implementer": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1}
      }
    },
    "reasoning": {
      "type": ["null", "object"],
      "additionalProperties": false,
      "required": ["control", "values", "default", "qualification"],
      "properties": {
        "control": {"enum": ["codex.model_reasoning_effort", "claude-code.effort"]},
        "values": {"type": ["null", "array"], "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "default": {"type": ["null", "string"], "minLength": 1},
        "qualification": {"type": "string", "minLength": 1}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "edition", "status", "client_support", "opt_in", "reasoning"],
      "properties": {
        "provider": {"enum": ["openai", "anthropic", "google"]},
        "edition": {"type": ["null", "string"]},
        "status": {"type": "string", "minLength": 1},
        "client_support": {"type": "string", "minLength": 1},
        "opt_in": {"type": "boolean"},
        "reasoning": {"$ref": "#/$defs/reasoning"},
        "native_fallback": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1}
      }
    }
  }
}
